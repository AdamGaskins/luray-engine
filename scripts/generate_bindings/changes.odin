    {"IsKeyDown", "key", "cast", "rl.KeyboardKey"},
    {"IsKeyReleased", "key", "cast", "rl.KeyboardKey"},
    {"IsKeyUp", "key", "cast", "rl.KeyboardKey"},
    {"SetExitKey", "key", "cast", "rl.KeyboardKey"},
