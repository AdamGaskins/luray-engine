    // functions
    {"IsWindowState", "flag", "transmute", "rl.ConfigFlags"},
    {"SetWindowState", "flags", "transmute", "rl.ConfigFlags"},
    {"ClearWindowState", "flags", "transmute", "rl.ConfigFlags"},
