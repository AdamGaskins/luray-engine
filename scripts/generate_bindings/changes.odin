    {"DrawLineStrip", "points", "pointCount"},
    {"DrawTriangleFan", "points", "pointCount"},
    {"DrawTriangleStrip", "points", "pointCount"},
    {"DrawSplineLinear", "points", "pointCount"},
    {"DrawSplineBasis", "points", "pointCount"},
